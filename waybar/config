{
  "layer": "top",
  "position": "top",
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "battery", "network", "custom/shortcuts"],

  "sway/workspaces": { "all-outputs": true },
  "sway/mode": {},

  "clock": {
    "interval": 1,
    "format": "{:%d.%m.%Y %H:%M:%S}"
  },

  "cpu": {
    "format": "CPU: {usage}%",
    "format-alt": "{usage}%"
  },

  "memory": {
    "format": "RAM: {used}/{total}MB"
  },

  "battery": {
  "states": {
    "warning": 30,
    "critical": 15
  },
  "format": "{capacity}%",
  "format-charging": "Battery charging: {capacity}%",
  "format-discharging": "Battery: {capacity}%",
  "format-full": "Battery full!",
  "interval": 30
},

  "network": {
    "format-up": "🌐 {essid} {ipaddr}",
    "format-down": "Disconnected"
  },

  "custom/shortcuts": {
    "exec": "echo '⛏️ Nerd bar ready!'",
    "interval": 10
  },

  "style": "~/.config/waybar/style.css",
  "tooltip": false,
  "sep": " | "
}
